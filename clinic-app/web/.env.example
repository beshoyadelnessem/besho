# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.
# Leave them empty to run the built-in demo (no database).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: must match the PATIENT_EMAIL_DOMAIN secret of the create-user function
VITE_PATIENT_EMAIL_DOMAIN=patients.invalid
# Optional: public VAPID key for push reminders
VITE_VAPID_PUBLIC_KEY=
